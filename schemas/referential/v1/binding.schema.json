{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brik.dev/schemas/referential/v1/binding.schema.json",
  "title": "Binding",
  "description": "Per-environment wiring: which credential authenticates against which endpoint, and which provider implements which capability. A 'none' provider is a legal, explicit binding checked against the profile policy.",
  "type": "object",
  "properties": {
    "apiVersion": { "const": "brik.dev/referential/v1" },
    "kind": { "const": "Binding" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "endpoints": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "capabilities": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    }
  },
  "required": ["apiVersion", "kind", "name"],
  "additionalProperties": false
}
