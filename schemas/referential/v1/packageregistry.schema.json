{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brik.dev/schemas/referential/v1/packageregistry.schema.json",
  "title": "PackageRegistry",
  "description": "A package registry endpoint (one per published format). The publisher modules consume the declared URL and TLS posture instead of per-manager ad-hoc variables.",
  "type": "object",
  "properties": {
    "apiVersion": { "const": "brik.dev/referential/v1" },
    "kind": { "const": "PackageRegistry" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "format": { "enum": ["npm", "pypi", "maven", "cargo", "nuget"] },
    "url": { "type": "string", "pattern": "^https?://.+" },
    "tls": {
      "type": "object",
      "properties": {
        "trust": { "enum": ["system", "custom-ca", "insecure"] }
      },
      "required": ["trust"],
      "additionalProperties": false
    }
  },
  "required": ["apiVersion", "kind", "name", "format", "url", "tls"],
  "additionalProperties": false
}
