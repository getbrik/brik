{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brik.dev/schemas/referential/v1/argocd.schema.json",
  "title": "ArgoCD",
  "description": "An Argo CD API server endpoint.",
  "type": "object",
  "properties": {
    "apiVersion": { "const": "brik.dev/referential/v1" },
    "kind": { "const": "ArgoCD" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "url": { "type": "string", "pattern": "^https?://.+" },
    "tls": {
      "type": "object",
      "properties": {
        "trust": { "enum": ["system", "custom-ca", "insecure"] }
      },
      "required": ["trust"],
      "additionalProperties": false
    },
    "grpc_web": { "type": "boolean" }
  },
  "required": ["apiVersion", "kind", "name", "url", "tls"],
  "additionalProperties": false
}
