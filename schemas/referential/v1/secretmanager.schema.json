{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brik.dev/schemas/referential/v1/secretmanager.schema.json",
  "title": "SecretManager",
  "description": "An OpenBAO (Vault-API) secret manager endpoint. KV mounts travel inside bao:// references; only a non-default Transit mount needs declaring (cosign reads it from TRANSIT_SECRET_ENGINE_PATH).",
  "type": "object",
  "properties": {
    "apiVersion": { "const": "brik.dev/referential/v1" },
    "kind": { "const": "SecretManager" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "url": { "type": "string", "pattern": "^https?://.+" },
    "transit_mount": { "type": "string" },
    "auth": {
      "type": "object",
      "properties": {
        "method": { "enum": ["token"], "deprecated": true },
        "ref": { "type": "string", "pattern": "^(env|file)://.+" }
      },
      "required": ["method", "ref"],
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "properties": {
        "trust": { "enum": ["system", "custom-ca", "insecure"] }
      },
      "required": ["trust"],
      "additionalProperties": false
    }
  },
  "required": ["apiVersion", "kind", "name", "url", "auth", "tls"],
  "additionalProperties": false
}
