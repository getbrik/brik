{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brik.dev/schemas/referential/v1/credential.schema.json",
  "title": "Credential",
  "description": "An authentication record holding references (env://, file://, bao://), never values. One auth technique per credential: a mixed record is a schema error.",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "apiVersion": { "const": "brik.dev/referential/v1" },
        "kind": { "const": "Credential" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "method": { "const": "basic" },
        "username": { "type": "string" },
        "password": { "type": "string", "pattern": "^(env|file|bao)://.+" }
      },
      "required": ["apiVersion", "kind", "name", "method", "username", "password"],
      "additionalProperties": false
    },
    {
      "properties": {
        "apiVersion": { "const": "brik.dev/referential/v1" },
        "kind": { "const": "Credential" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "method": { "const": "token" },
        "token": { "type": "string", "pattern": "^(env|file|bao)://.+" }
      },
      "required": ["apiVersion", "kind", "name", "method", "token"],
      "additionalProperties": false
    },
    {
      "properties": {
        "apiVersion": { "const": "brik.dev/referential/v1" },
        "kind": { "const": "Credential" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "method": { "const": "ssh-key" },
        "private_key": { "type": "string", "pattern": "^(env|file|bao)://.+" },
        "passphrase": { "type": "string", "pattern": "^(env|file|bao)://.+", "deprecated": true }
      },
      "required": ["apiVersion", "kind", "name", "method", "private_key"],
      "additionalProperties": false
    },
    {
      "properties": {
        "apiVersion": { "const": "brik.dev/referential/v1" },
        "kind": { "const": "Credential" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "method": { "const": "oidc", "deprecated": true },
        "issuer": { "type": "string", "pattern": "^https://.+", "deprecated": true }
      },
      "required": ["apiVersion", "kind", "name", "method"],
      "additionalProperties": false
    },
    {
      "properties": {
        "apiVersion": { "const": "brik.dev/referential/v1" },
        "kind": { "const": "Credential" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "method": { "const": "workload-identity" }
      },
      "required": ["apiVersion", "kind", "name", "method"],
      "additionalProperties": false
    },
    {
      "properties": {
        "apiVersion": { "const": "brik.dev/referential/v1" },
        "kind": { "const": "Credential" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "method": { "const": "mtls" },
        "client_cert": { "type": "string", "pattern": "^(env|file|bao)://.+" },
        "client_key": { "type": "string", "pattern": "^(env|file|bao)://.+" }
      },
      "required": ["apiVersion", "kind", "name", "method", "client_cert", "client_key"],
      "additionalProperties": false
    },
    {
      "properties": {
        "apiVersion": { "const": "brik.dev/referential/v1" },
        "kind": { "const": "Credential" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "method": { "const": "none" }
      },
      "required": ["apiVersion", "kind", "name", "method"],
      "additionalProperties": false
    }
  ]
}
