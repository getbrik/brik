{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brik.dev/schemas/state/v1/promotion-event.schema.json",
  "title": "Brik promotion journal event",
  "description": "One append-only, file-per-event record of the PromotionJournal (promotions/YYYY/MM/DD/<ts>-<uuid>.json in the state-repo). Every event is bound to the image digest (anti-replay): an eligibility granted to a version name alone could be replayed against a different artifact. Authorship and integrity come from the signed git commit that appends the file, never from fields inside the document.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "type", "version", "digest", "timestamp", "from_channel", "to_channel"],
      "properties": {
        "schema": { "const": "brik.promotion-event/v1" },
        "type": { "const": "artifact_promoted" },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
        "from_channel": { "type": "string", "minLength": 1 },
        "to_channel": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "type", "version", "digest", "timestamp", "environment"],
      "properties": {
        "schema": { "const": "brik.promotion-event/v1" },
        "type": { "enum": ["artifact_validated_for", "artifact_authorized_for"] },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
        "environment": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
