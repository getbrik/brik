#!/usr/bin/env bash
# brik - Portable CI/CD pipeline CLI
# Provides local tooling for validation, diagnostics, and stage execution.
# Does NOT participate in the production CI/CD flow - shared libraries do that.
#
# Usage: brik <command> [options]
# Commands: validate, doctor, init, run, self-update, self-uninstall, version, help
# shellcheck disable=SC1091
set -euo pipefail

# ---------------------------------------------------------------------------
# Bootstrap: resolve BRIK_HOME from the real location of this script
# ---------------------------------------------------------------------------
_brik_resolve_home() {
    local source="${BASH_SOURCE[0]}"
    local dir=""
    local bin_dir=""

    while [[ -L "${source}" ]]; do
        dir="$(cd -P "$(dirname "${source}")" && pwd)"
        source="$(readlink "${source}")"
        [[ "${source}" != /* ]] && source="${dir}/${source}"
    done

    bin_dir="$(cd -P "$(dirname "${source}")" && pwd)"
    dirname "${bin_dir}"
}

if [[ -n "${BRIK_HOME:-}" ]]; then
    _brik_resolved="$(_brik_resolve_home)"
    if [[ "${BRIK_HOME}" != "${_brik_resolved}" ]]; then
        printf 'warning: BRIK_HOME overridden by environment (%s)\n' "${BRIK_HOME}" >&2
    fi
    unset _brik_resolved
else
    BRIK_HOME="$(_brik_resolve_home)"
fi
readonly BRIK_HOME

# Source runtime foundations (version, logging, exit codes, module loader).
# BRIK_LIB is an optional escape hatch for user overrides (empty by default
# now that lib/core/ is gone). BRIK_LIB_EXTENSIONS enumerates the notion
# directories (pipeline/, transverse/, stacks/, rollout/, deployments/,
# package-managers/, stages/, cli/). Non-existent entries are harmless
# (loader tests existence before use).
export BRIK_LIB="${BRIK_LIB:-}"
export BRIK_LIB_EXTENSIONS="${BRIK_LIB_EXTENSIONS:-${BRIK_HOME}/lib/pipeline:${BRIK_HOME}/lib/transverse:${BRIK_HOME}/lib/stacks:${BRIK_HOME}/lib/rollout:${BRIK_HOME}/lib/deployments:${BRIK_HOME}/lib/package-managers:${BRIK_HOME}/lib/stages:${BRIK_HOME}/lib/cli:${BRIK_HOME}/lib}"
# shellcheck source=../lib/pipeline/version-info.sh
. "${BRIK_HOME}/lib/pipeline/version-info.sh"
# shellcheck source=../lib/pipeline/logging.sh
. "${BRIK_HOME}/lib/pipeline/logging.sh"
# shellcheck source=../lib/pipeline/error.sh
. "${BRIK_HOME}/lib/pipeline/error.sh"
# shellcheck source=../lib/pipeline/tools.sh
. "${BRIK_HOME}/lib/pipeline/tools.sh"
# shellcheck source=../lib/pipeline/loader.sh
. "${BRIK_HOME}/lib/pipeline/loader.sh"

# Default config and schema paths exposed as BRIK_* env vars so modules
# outside bin/brik's scope (lib/cli/validate.sh, future wrappers) can read
# them without relying on dynamic scope.
export BRIK_DEFAULT_CONFIG="brik.yml"
export BRIK_DEFAULT_SCHEMA="${BRIK_HOME}/schemas/config/v1/brik.schema.json"

# ---------------------------------------------------------------------------
# Utility functions (shared CLI primitives)
# ---------------------------------------------------------------------------

# shellcheck source=../lib/cli/helpers.sh
. "${BRIK_HOME}/lib/cli/helpers.sh"

# ---------------------------------------------------------------------------
# Command: version
# ---------------------------------------------------------------------------

cmd_version() {
    brik.use cli.version
    cli.version.run "$@"
}

# ---------------------------------------------------------------------------
# Command: help
# ---------------------------------------------------------------------------
cmd_help() {
    brik.use cli.help
    cli.help.run
}

# ---------------------------------------------------------------------------
# Command: validate
# ---------------------------------------------------------------------------
cmd_validate() {
    brik.use cli.validate
    cli.validate.run "$@"
}

# ---------------------------------------------------------------------------
# Command: doctor
# ---------------------------------------------------------------------------

cmd_doctor() {
    brik.use cli.doctor
    cli.doctor.run "$@"
}

# ---------------------------------------------------------------------------
# Command: init
# ---------------------------------------------------------------------------
cmd_init() {
    brik.use cli.init
    cli.init.run "$@"
}

# ---------------------------------------------------------------------------
# Command: self-update
# ---------------------------------------------------------------------------

cmd_self_update() {
    brik.use cli.self_update
    cli.self_update.run "$@"
}

# ---------------------------------------------------------------------------
# Command: self-uninstall
# ---------------------------------------------------------------------------

cmd_self_uninstall() {
    brik.use cli.self_uninstall
    cli.self_uninstall.run "$@"
}

# ---------------------------------------------------------------------------
# Command: integrate
# ---------------------------------------------------------------------------
cmd_integrate() {
    brik.use cli.integrate
    cli.integrate.run "$@"
}

# ---------------------------------------------------------------------------
# Command: stage
# ---------------------------------------------------------------------------
cmd_stage() {
    brik.use cli.stage
    cli.stage.run "$@"
}

# ---------------------------------------------------------------------------
# Command: plan
# ---------------------------------------------------------------------------
cmd_plan() {
    brik.use cli.plan
    cli.plan.run "$@"
}

# ---------------------------------------------------------------------------
# Command: deploy
# ---------------------------------------------------------------------------
cmd_deploy() {
    brik.use cli.deploy
    cli.deploy.run "$@"
}

# ---------------------------------------------------------------------------
# Command: extension
# ---------------------------------------------------------------------------
cmd_extension() {
    brik.use cli.extension
    cli.extension.run "$@"
}

# ---------------------------------------------------------------------------
# Command: registry
# ---------------------------------------------------------------------------
cmd_registry() {
    brik.use cli.registry
    cli.registry.run "$@"
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
main() {
    local command=""

    if [[ $# -eq 0 ]]; then
        cmd_help
        exit "${BRIK_EXIT_OK}"
    fi

    command="$1"
    shift

    case "${command}" in
        validate)
            cmd_validate "$@"
            exit "$?"
            ;;
        doctor)
            cmd_doctor "$@"
            exit "$?"
            ;;
        init)
            cmd_init "$@"
            exit "$?"
            ;;
        integrate)
            cmd_integrate "$@"
            exit "$?"
            ;;
        stage)
            cmd_stage "$@"
            exit "$?"
            ;;
        plan)
            cmd_plan "$@"
            exit "$?"
            ;;
        deploy)
            cmd_deploy "$@"
            exit "$?"
            ;;
        extension)
            cmd_extension "$@"
            exit "$?"
            ;;
        registry)
            cmd_registry "$@"
            exit "$?"
            ;;
        self-update)
            cmd_self_update "$@"
            exit "$?"
            ;;
        self-uninstall)
            cmd_self_uninstall "$@"
            exit "$?"
            ;;
        version)
            cmd_version "$@"
            exit "$?"
            ;;
        help|--help|-h)
            cmd_help
            exit "${BRIK_EXIT_OK}"
            ;;
        *)
            brik_usage_error "unknown command: ${command}" || exit "$?"
            ;;
    esac
}

main "$@"
