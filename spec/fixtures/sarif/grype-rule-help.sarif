{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "grype",
          "version": "0.111.1",
          "rules": [
            {
              "id": "CVE-2026-9001-python",
              "shortDescription": { "text": "synthetic critical no fix (real grype shape)" },
              "help": {
                "text": "Vulnerability CVE-2026-9001\nSeverity: critical\nPackage: python\nVersion: 3.13.13\nFix Version: \nType: binary\nLocation: /usr/local/bin/python3.13"
              },
              "properties": { "security-severity": "9.1" }
            },
            {
              "id": "CVE-2026-9002-python",
              "shortDescription": { "text": "synthetic high no fix (real grype shape)" },
              "help": {
                "text": "Vulnerability CVE-2026-9002\nSeverity: high\nPackage: python\nVersion: 3.13.13\nFix Version: \nType: binary"
              },
              "properties": { "security-severity": "8.5" }
            },
            {
              "id": "CVE-2026-9003-openssl",
              "shortDescription": { "text": "synthetic high with upstream fix (real grype shape)" },
              "help": {
                "text": "Vulnerability CVE-2026-9003\nSeverity: high\nPackage: openssl\nVersion: 3.0.0\nFix Version: 3.0.1\nType: apk"
              },
              "properties": { "security-severity": "7.5" }
            },
            {
              "id": "CVE-2026-9004-busybox",
              "shortDescription": { "text": "synthetic medium no fix (real grype shape)" },
              "help": {
                "text": "Vulnerability CVE-2026-9004\nSeverity: medium\nPackage: busybox\nVersion: 1.37.0\nFix Version: \nType: apk"
              },
              "properties": { "security-severity": "6.5" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2026-9001-python",
          "level": "error",
          "message": { "text": "A critical vulnerability in binary package: python" },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "image//usr/local/bin/python3.13" } } }]
        },
        {
          "ruleId": "CVE-2026-9002-python",
          "level": "error",
          "message": { "text": "A high vulnerability in binary package: python" },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "image//usr/local/bin/python3.13" } } }]
        },
        {
          "ruleId": "CVE-2026-9003-openssl",
          "level": "error",
          "message": { "text": "A high vulnerability in apk package: openssl" },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "image//usr/lib/libssl.so" } } }]
        },
        {
          "ruleId": "CVE-2026-9004-busybox",
          "level": "warning",
          "message": { "text": "A medium vulnerability in apk package: busybox" },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "image//bin/busybox" } } }]
        }
      ]
    }
  ]
}
