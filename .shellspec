--shell bash
--pattern "*_spec.sh"
--helperdir spec
--require spec_helper
--default-path "**/spec"
--env LC_NUMERIC=C
--jobs 16

## Default kcov (coverage) options
--kcov-options "--include-path=./bin,./lib,./shared-libs/gitlab/scripts,./shared-libs/jenkins/scripts,./shared-libs/local/scripts --path-strip-level=1"
--kcov-options "--include-pattern=.sh,/bin/brik"
--kcov-options "--exclude-path=./spec,./shared-libs/gitlab/spec,./shared-libs/jenkins/spec,./shared-libs/local/spec"
## Exclude multi-line jq/yq/awk script bodies from coverage counting.
## Wrap with `# KCOV_EXCL_START` / `# KCOV_EXCL_STOP` comments in source.
--kcov-options "--exclude-region=KCOV_EXCL_START:KCOV_EXCL_STOP"
## Single-line escape hatch for unreachable-on-CI lines (BSD/macOS stat/tar
## fallbacks, defensive guards). Marker: a trailing `# KCOV_EXCL_LINE`.
--kcov-options "--exclude-line=KCOV_EXCL_LINE"
